{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websecuritysdk.local/schemas/tactic.schema.json",
  "title": "Guided Security Testing Tactic Schema v0.1",
  "description": "Vulnerability-agnostic advisory testing guide schema for Option A (Guided Agent). Mandatory scope, policy, and evidence verification are enforced outside the LLM.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tactic_id",
    "name",
    "mode",
    "scope",
    "references",
    "required_context",
    "capabilities",
    "safety_rules",
    "steps",
    "outcomes",
    "confirmation_rules"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "tactic_id": {
      "type": "string",
      "pattern": "^TACTIC-[A-Z0-9-]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "mode": {
      "type": "string",
      "const": "GUIDED_AGENT"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vulnerability",
        "supported_input_locations",
        "limitations"
      ],
      "properties": {
        "vulnerability": {
          "type": "string",
          "minLength": 1
        },
        "supported_input_locations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "source",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "contract_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": ["required", "optional"]
          }
        }
      }
    },
    "safety_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "goal",
          "recommended_capability",
          "guidance",
          "next_options"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "recommended_capability": {
            "type": ["string", "null"]
          },
          "optional": {
            "type": "boolean"
          },
          "guidance": {
            "type": "string",
            "minLength": 1
          },
          "suggested_inputs": {
            "type": "object"
          },
          "next_options": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "when",
                "action",
                "reason"
              ],
              "properties": {
                "when": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "CONFIRMED",
          "NOT_CONFIRMED",
          "INCONCLUSIVE",
          "ERROR",
          "UNSUPPORTED",
          "POLICY_BLOCKED"
        ]
      }
    },
    "confirmation_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "upgrade_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
