# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Set only the one that matches the provider prefix in Settings.model
# ("gemini:...", "openai:...", "anthropic:...", or a bare Bedrock model id).

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bedrock reads the standard AWS chain; set these only if you have no profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
