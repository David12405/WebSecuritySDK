# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Set only the one that matches the provider prefix in Settings.model
# ("gemini:...", "openai:...", "anthropic:...", or a bare Bedrock model id).

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Bedrock reads the standard AWS chain; set these only if you have no profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --------------------------------------------------------------------------
# Layer 6 tools that need something outside Python
# --------------------------------------------------------------------------
#
# These reach the tools through `env:` in config/servers.yaml, which reads
# ${NAME} from here. Setting them in the shell instead works for a direct
# call like examples/probe_target.py and does NOT work through the SDK: an
# MCP server is a child process and inherits only a fixed list of variables.
#
# Unset is fine. The check that needs one comes back `failed` with
# E_TOOL_UNAVAILABLE naming the tool; every other check is unaffected.

# WhatWeb, for the `surface` check's fingerprint step. On Linux leave this empty - the
# binary is on PATH. On Windows it has no build, so point at the WSL shim:
#   WEBSEC_WHATWEB_PATH=D:\path\to\WebSecuritySDK\scripts\whatweb.cmd
# See scripts/README.md for installing it.
WEBSEC_WHATWEB_PATH=

# ZAP, for crawl_web and passive_web_analysis. No check uses these yet -
# the ZAP spider is active traffic and ARCHITECTURE.md 4.4 is unsettled.
# Start a daemon with scripts/zap-up.ps1 on Windows (or `docker run ... zaproxy/zap-stable`
# on Linux), which exposes the API on port 8080.
WEBSEC_ZAP_BASE_URL=
WEBSEC_ZAP_API_KEY=
# Proxy listener used by Playwright. It may be the same host/port as the
# ZAP API listener, depending on the daemon configuration.
WEBSEC_ZAP_PROXY_URL=

# Opengrep, for Layer 6 analyze_source and Module 2 LocalOpengrepAdapter.
# Leave WEBSEC_OPENGREP_PATH empty when `opengrep` is already on PATH (e.g. Linux/Kali).
# If installed via install.sh without adding it to PATH, use an explicit absolute path
# such as /home/<user>/.opengrep/cli/latest/opengrep (avoid unexpanded ~).
WEBSEC_OPENGREP_PATH=
# Layer 6 defaults to p/default when empty; Module 2 strict-offline and live M1->M2 tests
# require an existing absolute local ruleset path, e.g.:
#   WEBSEC_OPENGREP_RULESET=/path/to/WebSecuritySDK/tests/test_analysis/rules/cloudflare-workers-injection.yml
WEBSEC_OPENGREP_RULESET=
# Optional supplemental community rules directory for M1->M2 vendor audit only (untrusted for M2).
# WEBSEC_OPENGREP_VENDOR_RULESET=
