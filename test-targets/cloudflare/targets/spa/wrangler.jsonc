{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "spa-target",
  "main": "src/index.js",
  "compatibility_date": "2024-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "dev": {
    "port": 8789
  }
}
